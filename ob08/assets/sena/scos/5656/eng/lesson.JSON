{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter's Graduation"}, {"type": "unit_name", "content": "Writing a Speech"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 13}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about methods of communication and communication technology in common social situations."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}]}, {"type": "background_image", "content": "engenn5le13ob08re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Writing A Speech"}, {"type": "describer", "content": "<span class=\"strong\">An Introduction</span><br><br>  The first thing you need to do is get the audience's attention. Make sure you describe the topic and state why you are giving your speech. Finally, give an overview of the speech and its main points.  <br><br> Example (topic sentence):<br><br>  <span class=\"italic\">Today marks the end of one chapter and the beginning of a new one in the book of life.</span> <br><br> <span class=\"strong\">Main Points</span> <br><br> These are the key areas that you cover in your speech. <br><br> <span class=\"italic\">Example: friends, teachers, classes</span> <br><br> <span class=\"strong\">Transitions</span> <br><br> Transitions are the ways you move from one topic to another in a speech. <br><br> <span class=\"italic\">Example: likewise, also, furthermore</span>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Will, May, Might"}, {"type": "describer", "content": "You use the modals <span class=\"italic\">may</span>, <span class=\"italic\">might </span>or <span class=\"italic\">could </span> to show possibility.<br> They have the same meaning."}, {"type": "text", "content": "They are placed before a verb in the base form. The verb does not change."}, {"type": "example", "content": "Some might decide to take MBA degrees. "}, {"type": "example", "content": "Graduates may decide to begin internships or paid positions."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to deliver "}, {"type": "definition", "content": "to present a speech, statement, etc. to a group of people"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "  Example: Peter's classmate delivers the valedictorian speech."}, {"type": "audio", "content": "engenn5le13ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use in a speech."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "end of a chapter "}, {"type": "definition", "content": " a point in time that ends an event or stage "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Graduation marks the end of a chapter."}, {"type": "audio", "content": "engenn5le13ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to cram "}, {"type": "definition", "content": "to prepare for a test, exam, etc., by learning a lot of information quickly, usually the night before"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": " Example: We had to cram for our Accounting test."}, {"type": "audio", "content": "engenn5le13ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "remarkable "}, {"type": "definition", "content": "unusual or surprising, likely to be noticed  "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It's remarkable that three years of school is complete."}, {"type": "audio", "content": "engenn5le13ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "freshman "}, {"type": "definition", "content": "a student in the first year of high school or college "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: I am a freshman at college."}, {"type": "audio", "content": "engenn5le13ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to anticipate"}, {"type": "definition", "content": " to think of (something that will or might happen in the future)                                                                                                                     "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I am anticipating a lot of change next year."}, {"type": "audio", "content": "engenn5le13ob08aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think about 2 important things you learned from school."}, {"type": "text", "content": "Write two 70-word paragraphs. Each paragraph has 1 main point."}, {"type": "text", "content": "Include a topic sentence, supporting sentences and a concluding sentence."}, {"type": "text", "content": "Use a transition to join the paragraphs together like <span class=\"italic\">also</span>, <span class=\"italic\">furthermore</span>, or <span class=\"italic\">likewise</span>."}, {"type": "text", "content": "Read your paragraphs to a partner."}, {"type": "text", "content": "Remember to keep your audience's attention."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I think about past experiences."}, {"type": "text", "content": "I write paragraphs about school and education."}, {"type": "text", "content": "I present part of a speech to a partner."}]}], "type": "sena", "labs": [{"id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "type": "scholar", "exercises": [{"_data": [{"type": "instructions", "contents": [{"type": "Learning Outcomes", "content": " I can write a short speech."}, {"type": "Learning Outcomes", "content": "  I can talk or report about actions, events or people. "}, {"type": "Learning Outcomes", "content": "  I can say what I'm doing in the future."}, {"type": "Free Header Item", "content": " Do you like to make speeches? "}, {"type": "Free Header Item", "conte