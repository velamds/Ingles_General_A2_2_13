s up"}, {"type": "definition", "content": "to put on formal clothing "}, {"type": "part_speech", "content": " (verb)"}, {"type": "example", "content": "Example: Everyone at the graduation ceremony is dressed up!"}, {"type": "audio", "content": "engenn5le13ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you hear at a graduation ceremony."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to take off "}, {"type": "definition", "content": "to remove "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She's taking off her coat. "}, {"type": "audio", "content": "engenn5le13ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "pale "}, {"type": "definition", "content": " light in color  "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She has on a pale blue coat."}, {"type": "audio", "content": "engenn5le13ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "striped"}, {"type": "definition", "content": "a pattern of lines "}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: My dad is wearing a grey striped jacket."}, {"type": "audio", "content": "engenn5le13ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cap and gown "}, {"type": "definition", "content": "a mortar board cap and academic style coat worn at graduation ceremonies "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Everyone put on their caps and gowns before the ceremony."}, {"type": "audio", "content": "engenn5le13ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "chancellor"}, {"type": "definition", "content": "a legal official  "}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": "Example: The university chancellor spoke at the graduation."}, {"type": "audio", "content": "engenn5le13ob06aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "dean "}, {"type": "definition", "content": "a person responsible for a department at a university"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: The dean asked to see me about a scholarship."}, {"type": "audio", "content": "engenn5le13ob06aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a 50-75 word dialogue."}, {"type": "text", "content": "You are pointing out your family to a friend at a graduation ceremony."}, {"type": "text", "content": "Point out someone standing near them."}, {"type": "text", "content": "Say what they look like."}, {"type": "text", "content": "Say what they are wearing."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about my family at a graduation ceremony."}, {"type": "text", "content": "I say what they look like."}, {"type": "text", "content": "I say what they are wearing."}, {"type": "text", "content": "I listen to my partner talk about their family."}]}], "type": "sena"}