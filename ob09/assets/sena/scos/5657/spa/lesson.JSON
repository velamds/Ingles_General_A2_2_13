{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter's Graduation"}, {"type": "unit_name", "content": "The Valedictorian Speech"}, {"type": "position", "content": 9}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 13}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about methods of communication and communication technology in common social situations."}, {"type": "secondary_1", "content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level"}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative