{"_data": [{"contents": [{"content": "Peter's Graduation", "type": "lesson_name"}, {"content": "Parting Ways With Mates", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 13, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Identify and describe plans for the organization of events.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level. ", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Making and Responding to Promises", "type": "heading"}, {"content": "You use the Future tense (with <span class=\"italic\">will</span>) to make promises.", "type": "describer"}, {"content": "You can start the sentence with <span class=\"italic\">\"I promise I'll \u2026 \"</span> or <span class=\"italic\">\"I promise to \u2026 \"</span> or <span class=\"italic\">\"I'll \u2026 \"</span>", "type": "text"}, {"content": "You can respond to promises with an expression like:", "type": "text"}, {"content": "<span class=\"italic\">Great, thank you!</span> <br> <span class=\"italic\">Alright.</span> <br><span class=\"italic\">OK.</span> <br> <span class=\"italic\">That's fine.</span> <br><span class=\"italic\">Sure, that works.</span>  ", "type": "text"}, {"content": "<span class=\"strong\">Anne</span>: I'll keep in touch, I promise. <br> <span class=\"strong\">Jeff</span>: Great, I look forward to that!", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Simple Future", "type": "heading"}, {"content": " You can use the Simple Future tense <span class=\"italic\">will </span>and modals like <span class=\"italic\">may</span> and <span class=\"italic\">might</span> to talk about a future that is not decided or certain.", "type": "describer"}, {"content": "You can also use <span class=\"italic\">will </span>to make promises. <br>You use <span class=\"italic\">may</span> and <span class=\"italic\">might</span> to suggest the possibility of something in the future. Often <span class=\"italic\">might</span> can suggest a smaller possibility than <span class=\"italic\">may</span>. However, there is little difference. <span class=\"italic\">Might</span> is more usual than <span class=\"italic\">may </span>in spoken English.", "type": "text"}, {"content": "He<span class=\"strong\">'ll help</span>  you with your  convocation speech later.", "type": "example"}, {"content": "I <span class=\"strong\">might meet</span> Vanessa tonight.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "to promise", "type": "name"}, {"content": "to say you will do something; give your word", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I promise the course will be easy. ", "type": "example"}, {"content": "engenn5le13ob05aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use at a school graduation.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to regret", "type": "name"}, {"content": "to be sorry you did something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You won't regret taking this course! ", "type": "example"}, {"content": "engenn5le13ob05aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "alumni", "type": "name"}, {"content": "people who went to the school ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Many alumni came to the graduation ceremony.", "type": "example"}, {"content": "engenn5le13ob05aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to enter", "type": "name"}, {"content": "to add; to type in ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Let me enter my information into your phone.  ", "type": "example"}, {"content": "engenn5le13ob05aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "blackboard ", "type": "name"}, {"content": "chalkboard; where teachers write in a classroom ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He wrote so much on the blackboard! ", "type": "example"}, {"content": "engenn5le13ob05aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn5le13ob05re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Write a dialogue catching up with a friend.", "type": "text"}, {"content": "Say what you were doing/did in the past.", "type": "text"}, {"content": "Say what you may/might do in the future.", "type": "text"}, {"content": "Ask for your friend's information for my phone.", "type": "text"}, {"content": "Make a promise, like to meet for lunch.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a 50 to 75 word dialogue catching up with a friend.", "type": "text"}, {"content": "I talk about what I did and was doing.", "type": "text"}, {"content": "I talk about actions and events in the future.", "type": "text"}, {"content": "I ask for their information for my phone.", "type": "text"}, {"content": "I make a promise.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le13ob05re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le13ob05re2img01.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Peter</span>: Camilla! Are you here for graduation? <br>\n<span class=\"strong\">Camilla</span>: Yes! It's nice to see you Peter! Where do we go?<br>\n<span class=\"strong\">Peter</span>: This might be the way down here.<br>\n<span class=\"strong\">Camilla</span>: Oh, look! There's our accounting classroom.<br>\n<span class=\"strong\">Peter</span>: Oh, man! Remember the first day? It was horrible!<br>\n<span class=\"strong\">Camilla</span>: Yeah. Mr. Philips was all - \u201cI promise you'll  find this interesting\u201d!<br>"}, {"image": "engenn5le13ob05re2img05.jpg", "time": "18500", "id": 2, "text": "<span class=\"strong\">Peter</sp