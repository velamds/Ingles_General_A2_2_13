 "type": "part_speech"}, {"content": "Example: Help me pick out a new dress.", "type": "example"}, {"content": "engenn5le13ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to pull out", "type": "name"}, {"content": "to bring something out of a closet or drawer", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Pull some clothes out of your closet for me to look at.", "type": "example"}, {"content": "engenn5le13ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to hold", "type": "name"}, {"content": "to keep in your hand", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Hold the shirt in the light.   ", "type": "example"}, {"content": "engenn5le13ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "presentable", "type": "name"}, {"content": "suitable; good enough ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Those pants aren't presentable. Buy a new pair!", "type": "example"}, {"content": "engenn5le13ob03aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to polish", "type": "name"}, {"content": "to make shiny", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Polish your shoes.", "type": "example"}, {"content": "engenn5le13ob03aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "you're all set ", "type": "name"}, {"content": "you have everything you need", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Now you have your outfit, so you're all set for the graduation.", "type": "example"}, {"content": "engenn5le13ob03aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Look in your closet and choose some items of clothing.", "type": "text"}, {"content": "Write 3 sentences comparing 2 items.", "type": "text"}, {"content": "Write 3 sentences comparing 3 items.", "type": "text"}, {"content": "Use a variety of adjectives.", "type": "text"}, {"content": "Read your sentences aloud to a partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I compare items of clothing.", "type": "text"}, {"content": "I compare three items of clothing.", "type": "text"}, {"content": "I use different adjectives.", "type": "text"}, {"content": "I read my sentences aloud.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"contents": [{}], "template_override": 1, "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le13ob03re2img10.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le13ob03re2img10.jpg", "time": "10", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: What are you wearing to your graduation? <br>\n<span class=\"strong\">Peter</span>: Wearing? Something comfortable I think.<br>\n<span class=\"strong\">Vanessa</span>: Something nice is better.<br>\n<span class=\"strong\">Peter</span>: Could you help me pick something out?<br>\n<span class=\"strong\">Vanessa</span>: Sure. I can do that. Take the computer to your room and show me what's in your closet. Can you pull some things out?<br>\n<span class=\"strong\">Peter</span>: Yep. How about about this shirt?<br>"}, {"image": "engenn5le13ob03re2img01.jpg", "time": "19000", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Could you find something newer and cleaner?<br>\n<span class=\"strong\">Peter</span>: This one? <br>\n<span class=\"strong\">Vanessa</span>: That's nicer. Now, pants.<br>\n<span class=\"strong\">Peter</span>: Darker or lighter pants? <br>\n<span class=\"strong\">Vanessa</span>: Darker pants are the best choice. Would you hold them in the light, please?<br>\n<span class=\"strong\">Peter</span>: Okay. Here you go.<br>"}, {"image": "engenn5le13ob03re2img09.jpg", "time": "33500", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: The ones on the left are the most presentable.<br>\n<span class=\"strong\">Peter</span> Shoes? These are the most comfortable ones.<br>\n<span class=\"strong\">Vanessa</span>: They're okay. Get them polished. Now you need a brighter tie to pull the outfit together.<br>\n<span class=\"strong\">Peter</span>: Can I wear this one? <br>\n<span class=\"strong\">Vanessa</span>: Yes. Good choice. Now you're all set.<br>"}], "audiosrc": "engenn5le13ob03re2aud01", "coverimg": "engenn5le13ob03re2img10.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "questions": [], "type": "WLC", "_data": [{"contents": [{"content": " I can talk about clothes and appearance. ", "type": "Learning Outcomes"}, {"content": " I can make and respond to requests.", "type": "Learning Outcomes"}, {"content": "  I can compare two things.  ", "type": "Learning Outcomes"}, {"content": " How often do you go through your closet to take out old clothes? ", "type": "Free Header Item"}, {"content": " How often do you find things that you hardly ever wear? ", "type": "Free Header Item"}, {"content": " What do you do with your old clothes?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "What clothes are in your closet?", "type": "free_type_text_area"}], "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "questions": [{"_data": [{"contents": [{"content": "",